---
interface Props {
  name: string;
  emoji: string;
  team: string;
  goal: string;
}

const { name, emoji, team, goal } = Astro.props;
---

<article class="card">
  <div class="emoji" aria-hidden="true">{emoji}</div>
  <h2>{name}</h2>
  <p class="team">{team}</p>
  <p class="goal">{goal}</p>
  <div class="body"><slot /></div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .emoji {
    font-size: 2rem;
  }

  h2 {
    margin: 8px 0 0;
    font-size: 1.125rem;
  }

  .team {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .goal {
    margin: 12px 0 0;
  }

  .body :global(p) {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
