---
// The figure every piece is drawn on, in the 240 x 360 coordinate system.
interface Props {
  faint?: boolean;
}

const { faint = false } = Astro.props;
const skin = '#5a5078';
---

<g class:list={['mannequin', { faint }]} fill={skin}>
  <rect x="92" y="226" width="24" height="112" rx="10"></rect>
  <rect x="124" y="226" width="24" height="112" rx="10"></rect>
  <ellipse cx="102" cy="340" rx="16" ry="7"></ellipse>
  <ellipse cx="138" cy="340" rx="16" ry="7"></ellipse>
  <path d="M84 122 L60 222 M156 122 L180 222" stroke={skin} stroke-width="16" stroke-linecap="round"></path>
  <circle cx="58" cy="228" r="10"></circle>
  <circle cx="182" cy="228" r="10"></circle>
  <path d="M80 120 Q120 106 160 120 L154 234 Q120 242 86 234 Z"></path>
  <rect x="111" y="96" width="18" height="18" rx="4"></rect>
  <circle cx="120" cy="68" r="34"></circle>
  <circle cx="108" cy="66" r="3.5" fill="#1b1426"></circle>
  <circle cx="132" cy="66" r="3.5" fill="#1b1426"></circle>
  <path d="M110 82 Q120 89 130 82" fill="none" stroke="#1b1426" stroke-width="2.5" stroke-linecap="round"></path>
</g>

<style>
  .faint {
    opacity: 0.3;
  }
</style>
